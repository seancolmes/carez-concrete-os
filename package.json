{
  "name": "carez-concrete-os",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "build": "node scripts/copy-pdf-worker.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "carez:release-gate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/carez-release-gate.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.343",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@refinedev/core": "^5.0.12",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.112.4",
    "clsx": "^2.1.1",
    "flexlayout-react": "^0.11.1",
    "framer-motion": "^13.4.4",
    "geist": "1.7.0",
    "next": "15.5.24",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-draggable": "^4.7.2",
    "react-resizable": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "postcss": "^8.5.26",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  }
}
