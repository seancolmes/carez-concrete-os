# Use credentials for one environment/project only. No real credentials belong here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
# Server-only, independent >=32 random bytes for short-lived recovery proofs.
AUTH_RECOVERY_SIGNING_KEY=
# Server-only domain-restricted transactional sender; recovery tokens are
# registered before delivery. Provider SMTP still owns other Auth messages.
AUTH_RECOVERY_EMAIL_API_KEY=
AUTH_RECOVERY_EMAIL_FROM=

# Server-only verified document registration; never use a NEXT_PUBLIC prefix.
# Must belong to the project named by NEXT_PUBLIC_SUPABASE_URL.
# A defined dedicated key takes precedence; invalid or blank values fail closed.
POURTRACE_SUPABASE_SERVICE_ROLE_KEY=

# Optional local/legacy fallback: omit the dedicated variable entirely to use it.
# SUPABASE_SERVICE_ROLE_KEY=
